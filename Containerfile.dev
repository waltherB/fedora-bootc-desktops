# Developer desktop — KDE Atomic (Kinoite) base
ARG FEDORA_MAJOR_VERSION=44
FROM quay.io/fedora/fedora-kinoite:${FEDORA_MAJOR_VERSION}

ARG IMAGE_NAME=dev-desktop
ARG FEDORA_MAJOR_VERSION

# --- Labels: bootc switch shows these in `bootc status` ---
ENV NAME="waba-${IMAGE_NAME}" \
    VERSION="${FEDORA_MAJOR_VERSION}" \
    IMAGE_NAME="${IMAGE_NAME}"
LABEL com.github.waltherb.bootc-desktop="${IMAGE_NAME}" \
      org.opencontainers.image.title="waba ${IMAGE_NAME} (Fedora ${FEDORA_MAJOR_VERSION})" \
      org.opencontainers.image.description="Custom Fedora KDE Atomic desktop — developer edition" \
      org.opencontainers.image.source="https://github.com/waltherB/fedora-bootc-desktops" \
      org.opencontainers.image.licenses="MIT"

# --- Core dev toolchain ---
# Note: Fedora 44 dropped java-21-openjdk (default JDK is 25) and ships
# versioned Node.js packages (npm is bundled inside nodejs24). ---
RUN dnf -y install \
      git git-lfs \
      make automake gcc gcc-c++ kernel-devel \
      python3 python3-pip python3-devel \
      nodejs24 \
      golang rust cargo \
      java-25-openjdk-devel maven \
      podman podman-compose toolbox \
      htop tmux wget curl jq \
    && dnf clean all

# --- Editors / IDEs available as RPMs.
#     Day-2 rule of thumb: anything not here (VS Code, JetBrains, etc.)
#     goes in Flatpak, NOT in the image. Keep the image lean. ---
RUN dnf -y install \
      neovim helix \
      gh qemu-guest-agent \
    && dnf clean all

# Add Flathub repository and install developer apps system-wide
RUN flatpak remote-delete --force flathub || true && \
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && \
    flatpak install --system -y flathub \
        com.visualstudio.code \
        io.podman_desktop.PodmanDesktop

# Add Atea wallpapers
COPY files/atea-danmark-fedora-kinoite-administrator-wallpaper-3840×2160.svg /usr/share/backgrounds/atea-danmark-fedora-kinoite-administrator-wallpaper-3840×2160.svg
COPY files/atea-danmark-fedora-kinoite-developer-wallpaper-3840×2160.svg /usr/share/backgrounds/atea-danmark-fedora-kinoite-developer-wallpaper-3840×2160.svg


# --- Enable qemu-guest-agent
RUN systemctl enable qemu-guest-agent

# --- Default demo user (uid/gid 1000, admin via wheel) ---
# Password is set at build time via chpasswd; change or remove this
# block for anything beyond local/demo use.
RUN useradd --uid 1000 --create-home --user-group --groups wheel demo \
    && echo 'demo:redhat' | chpasswd

# --- Bash customization for every new user ---
COPY --chmod=0644 files/etc/skel/.bashrc.d/10-waba.sh /etc/skel/.bashrc.d/10-waba.sh

# --- Default root filesystem for bootc install / bootc-image-builder ---
RUN mkdir -p /usr/lib/bootc/install && \
    printf '[install.filesystem.root]\ntype = "xfs"\n' \
      > /usr/lib/bootc/install/00-waba.toml

# --- DNS: Cloudflare + Google via systemd-resolved ---
RUN mkdir -p /usr/lib/systemd/resolved.conf.d && \
    printf '[Resolve]\nDNS=1.1.1.1 8.8.8.8\n' \
      > /usr/lib/systemd/resolved.conf.d/10-waba-dns.conf && \
    systemctl enable systemd-resolved

# --- bootc hygiene ---
# /usr is the image; /var (and therefore /etc changes, homes) survives across images,
# which is what makes switching between dev/admin painless.
RUN bootc container lint
